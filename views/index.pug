extends layout

block content
  section.hero
    img.hero-logo(src="/images/logo-saffron.png" alt="Downtown Donuts Logo")
    h1 Downtown Donuts
    p Fresh donuts & coffee since 1992.
    a.cta(href="/menu") Explore Our Menu

  section.features
    h2(style="text-align:center; color:#10291D; margin-top:40px;") What We Offer
    ul(style="max-width:600px; margin:auto; font-size:18px;")
      li Fresh artisan donuts
      li Locally roasted coffee
      li Online ordering options


